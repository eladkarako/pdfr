<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PDFr only opens local files. Nothing in the reader needs the network,
         so strip the permissions that some libraries declare by default. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:layoutDirection="ltr"
        android:supportsRtl="false"
        android:theme="@style/Theme.PDFr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PDFr">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" a document from a content provider. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:mimeType="application/vnd.ms-xpsdocument" />
                <data android:scheme="content" android:mimeType="application/oxps" />
                <data android:scheme="content" android:mimeType="application/xps" />
                <data android:scheme="content" android:mimeType="application/vnd.comicbook+zip" />
                <data android:scheme="content" android:mimeType="application/x-cbz" />
                <data android:scheme="content" android:mimeType="application/x-cbt" />
                <data android:scheme="content" android:mimeType="application/x-fictionbook+xml" />
                <data android:scheme="content" android:mimeType="application/x-fictionbook" />
                <data android:scheme="content" android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/html" />
                <data android:scheme="content" android:mimeType="application/xhtml+xml" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="text/x-markdown" />
                <data android:scheme="content" android:mimeType="image/svg+xml" />
                <data android:scheme="content" android:mimeType="image/bmp" />
                <data android:scheme="content" android:mimeType="image/gif" />
                <data android:scheme="content" android:mimeType="image/jpeg" />
                <data android:scheme="content" android:mimeType="image/png" />
                <data android:scheme="content" android:mimeType="image/tiff" />
                <data android:scheme="content" android:mimeType="image/x-tiff" />
                <data android:scheme="content" android:mimeType="image/jp2" />
                <data android:scheme="content" android:mimeType="image/jpx" />
                <data android:scheme="content" android:mimeType="image/jxr" />
                <data android:scheme="content" android:mimeType="image/vnd.ms-photo" />
                <data android:scheme="content" android:mimeType="image/vnd.adobe.photoshop" />
                <data android:scheme="content" android:mimeType="image/x-jbig2" />
                <data android:scheme="content" android:mimeType="image/x-portable-anymap" />
                <data android:scheme="content" android:mimeType="image/x-portable-arbitrarymap" />
                <data android:scheme="content" android:mimeType="image/x-portable-bitmap" />
                <data android:scheme="content" android:mimeType="image/x-portable-greymap" />
                <data android:scheme="content" android:mimeType="image/x-portable-pixmap" />
                <data android:scheme="content" android:mimeType="image/x-portable-floatmap" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:scheme="content" android:mimeType="application/haansofthwpx" />
                <data android:scheme="content" android:mimeType="application/vnd.hancom.hwpx" />
            </intent-filter>

            <!-- file:// is intentionally unsupported: under scoped storage an
                 app without broad storage access cannot read another app's
                 file path, so those intents would only end in an error. -->

            <!-- "Share to PDFr" from any app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.ms-xpsdocument" />
                <data android:mimeType="application/oxps" />
                <data android:mimeType="application/xps" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbt" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="image/bmp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="image/x-tiff" />
                <data android:mimeType="image/jp2" />
                <data android:mimeType="image/jpx" />
                <data android:mimeType="image/jxr" />
                <data android:mimeType="image/vnd.ms-photo" />
                <data android:mimeType="image/vnd.adobe.photoshop" />
                <data android:mimeType="image/x-jbig2" />
                <data android:mimeType="image/x-portable-anymap" />
                <data android:mimeType="image/x-portable-arbitrarymap" />
                <data android:mimeType="image/x-portable-bitmap" />
                <data android:mimeType="image/x-portable-greymap" />
                <data android:mimeType="image/x-portable-pixmap" />
                <data android:mimeType="image/x-portable-floatmap" />
                <data
                    android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data
                    android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data
                    android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/haansofthwpx" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
