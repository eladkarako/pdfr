<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PDFr only opens local files. Nothing in the reader needs the network,
         so strip the permissions that some libraries declare by default. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:layoutDirection="ltr"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.PDFr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PDFr">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" a document from a content provider. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:mimeType="application/pdf"
                    android:scheme="content" />
                <data
                    android:mimeType="application/epub+zip"
                    android:scheme="content" />
                <data
                    android:mimeType="application/vnd.ms-xpsdocument"
                    android:scheme="content" />
                <data
                    android:mimeType="application/oxps"
                    android:scheme="content" />
                <data
                    android:mimeType="application/xps"
                    android:scheme="content" />
                <data
                    android:mimeType="application/vnd.comicbook+zip"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-cbz"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-cbt"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-fictionbook+xml"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-fictionbook"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-mobipocket-ebook"
                    android:scheme="content" />
                <data
                    android:mimeType="text/plain"
                    android:scheme="content" />
                <data
                    android:mimeType="text/*"
                    android:scheme="content" />
                <data
                    android:mimeType="text/html"
                    android:scheme="content" />
                <data
                    android:mimeType="application/xhtml+xml"
                    android:scheme="content" />
                <data
                    android:mimeType="text/markdown"
                    android:scheme="content" />
                <data
                    android:mimeType="text/x-markdown"
                    android:scheme="content" />
                <data
                    android:mimeType="application/json"
                    android:scheme="content" />
                <data
                    android:mimeType="application/xml"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-sh"
                    android:scheme="content" />
                <data
                    android:mimeType="application/javascript"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-javascript"
                    android:scheme="content" />
                <data
                    android:mimeType="application/ecmascript"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-yaml"
                    android:scheme="content" />
                <data
                    android:mimeType="application/yaml"
                    android:scheme="content" />
                <data
                    android:mimeType="application/toml"
                    android:scheme="content" />
                <data
                    android:mimeType="application/sql"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-ndjson"
                    android:scheme="content" />
                <data
                    android:mimeType="application/jsonl"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-httpd-php"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-perl"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-python"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-ruby"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-tex"
                    android:scheme="content" />
                <data
                    android:mimeType="application/x-properties"
                    android:scheme="content" />
                <data
                    android:mimeType="application/csv"
                    android:scheme="content" />
                <data
                    android:mimeType="application/tsv"
                    android:scheme="content" />
                <data
                    android:mimeType="image/svg+xml"
                    android:scheme="content" />
                <data
                    android:mimeType="image/bmp"
                    android:scheme="content" />
                <data
                    android:mimeType="image/gif"
                    android:scheme="content" />
                <data
                    android:mimeType="image/jpeg"
                    android:scheme="content" />
                <data
                    android:mimeType="image/png"
                    android:scheme="content" />
                <data
                    android:mimeType="image/tiff"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-tiff"
                    android:scheme="content" />
                <data
                    android:mimeType="image/jp2"
                    android:scheme="content" />
                <data
                    android:mimeType="image/jpx"
                    android:scheme="content" />
                <data
                    android:mimeType="image/jxr"
                    android:scheme="content" />
                <data
                    android:mimeType="image/vnd.ms-photo"
                    android:scheme="content" />
                <data
                    android:mimeType="image/vnd.adobe.photoshop"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-jbig2"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-portable-anymap"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-portable-arbitrarymap"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-portable-bitmap"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-portable-greymap"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-portable-pixmap"
                    android:scheme="content" />
                <data
                    android:mimeType="image/x-portable-floatmap"
                    android:scheme="content" />
            </intent-filter>

            <!-- file:// is intentionally unsupported: under scoped storage an
                 app without broad storage access cannot read another app's
                 file path, so those intents would only end in an error. -->

            <!-- "Share to PDFr" from any app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-javascript" />
                <data android:mimeType="application/ecmascript" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/x-ndjson" />
                <data android:mimeType="application/jsonl" />
                <data android:mimeType="application/x-httpd-php" />
                <data android:mimeType="application/x-perl" />
                <data android:mimeType="application/x-python" />
                <data android:mimeType="application/x-ruby" />
                <data android:mimeType="application/x-tex" />
                <data android:mimeType="application/x-properties" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/tsv" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.ms-xpsdocument" />
                <data android:mimeType="application/oxps" />
                <data android:mimeType="application/xps" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbt" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="image/bmp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="image/x-tiff" />
                <data android:mimeType="image/jp2" />
                <data android:mimeType="image/jpx" />
                <data android:mimeType="image/jxr" />
                <data android:mimeType="image/vnd.ms-photo" />
                <data android:mimeType="image/vnd.adobe.photoshop" />
                <data android:mimeType="image/x-jbig2" />
                <data android:mimeType="image/x-portable-anymap" />
                <data android:mimeType="image/x-portable-arbitrarymap" />
                <data android:mimeType="image/x-portable-bitmap" />
                <data android:mimeType="image/x-portable-greymap" />
                <data android:mimeType="image/x-portable-pixmap" />
                <data android:mimeType="image/x-portable-floatmap" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
