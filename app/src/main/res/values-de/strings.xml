    <string name="normalize">Normalisieren…</string>
    <string name="normalize_title">PDF normalisieren</string>
    <string name="normalize_body">Wendet die ausgewählten qpdf-Optimierungen in einem Durchgang in einer Reihenfolge an, die das Ergebnis gültig hält. Die optimierte Kopie ersetzt das aktuelle Dokument.</string>
    <string name="normalize_apply">Normalisieren</string>
    <string name="normalize_done">Normalisiertes PDF erstellt.</string>
    <string name="normalize_unavailable">qpdf ist in dieser Version nicht verfügbar.</string>
    <string name="normalize_section_streams">Streams</string>
    <string name="normalize_compress_streams">Streams komprimieren</string>
    <string name="normalize_compress_streams_desc">Komprimiert Streams, die noch nicht komprimiert sind.</string>
    <string name="normalize_decode_all">Alle Streams dekodieren</string>
    <string name="normalize_decode_all_desc">Dekomprimiert jeden unterstützten Stream, einschließlich JPEG-Bildern. Am besten mit Bildoptimierung kombinieren.</string>
    <string name="normalize_recompress_flate">Flate neu komprimieren</string>
    <string name="normalize_recompress_flate_desc">Dekomprimiert und komprimiert Flate-Streams neu. Erforderlich vor einer Änderung der Komprimierungsstufe.</string>
    <string name="normalize_compression_level">Maximale Komprimierung (Stufe 9)</string>
    <string name="normalize_compression_level_desc">Verwendet die höchste Flate-Komprimierungsstufe von qpdf.</string>
    <string name="normalize_section_images">Bilder</string>
    <string name="normalize_optimize_images">Bilder optimieren</string>
    <string name="normalize_optimize_images_desc">Kodiert Bilder mit der effizienten Komprimierung von qpdf neu. Kann verlustbehaftet sein, wenn die JPEG-Qualität unter 100 liegt.</string>
    <string name="normalize_jpeg_quality">JPEG-Qualität</string>
    <string name="normalize_jpeg_quality_desc">0 (kleinste) bis 100 (beste). Wird nur bei der Bildoptimierung verwendet.</string>
    <string name="normalize_quality_error">Geben Sie eine Qualität von 0 bis 100 ein.</string>
    <string name="normalize_section_structure">Struktur</string>
    <string name="normalize_newline">Zeilenumbruch vor endstream</string>
    <string name="normalize_newline_desc">Fügt vor jedem endstream einen Zeilenumbruch ein. Hilft qpdf, PDF/A zu erhalten.</string>
    <string name="normalize_remove_resources">Nicht referenzierte Ressourcen entfernen</string>
    <string name="normalize_remove_resources_desc">Entfernt Seitenressourcen, die von keinem Inhalt der Seite verwendet werden.</string>
    <string name="normalize_externalize_images">Inline-Bilder auslagern</string>
    <string name="normalize_externalize_images_desc">Verschiebt in Inhaltsstreams eingebettete Bilder in reguläre Bildobjekte.</string>
    <string name="normalize_section_output">Ausgabe</string>
    <string name="normalize_linearize">Linearisieren</string>
    <string name="normalize_linearize_desc">Schreibt ein weboptimiertes PDF, das die erste Seite anzeigen kann, bevor der Rest gelesen wird.</string>
    <string name="normalize_pdfa">PDF/A-2b (nach bestem Bemühen)</string>
    <string name="normalize_pdfa_desc">Fügt die PDF/A-2b-Kennzeichnung und eine sRGB-Ausgabeabsicht hinzu. Schriften und Inhalte werden nicht konvertiert; prüfen Sie das Ergebnis vor der Archivierung.</string>

