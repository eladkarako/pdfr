    <string name="normalize">Normalizar…</string>
    <string name="normalize_title">Normalizar PDF</string>
    <string name="normalize_body">Aplica en una sola pasada las optimizaciones de qpdf seleccionadas, en un orden que mantiene válido el resultado. La copia ajustada sustituye al documento actual.</string>
    <string name="normalize_apply">Normalizar</string>
    <string name="normalize_done">Se ha creado el PDF normalizado.</string>
    <string name="normalize_unavailable">qpdf no está disponible en esta versión.</string>
    <string name="normalize_section_streams">Flujos</string>
    <string name="normalize_compress_streams">Comprimir flujos</string>
    <string name="normalize_compress_streams_desc">Comprime los flujos que aún no lo están.</string>
    <string name="normalize_decode_all">Descodificar todos los flujos</string>
    <string name="normalize_decode_all_desc">Descomprime todos los flujos compatibles, incluidas las imágenes JPEG. Conviene combinarlo con la optimización de imágenes.</string>
    <string name="normalize_recompress_flate">Recomprimir Flate</string>
    <string name="normalize_recompress_flate_desc">Descomprime y vuelve a comprimir los flujos Flate. Es necesario antes de cambiar el nivel de compresión.</string>
    <string name="normalize_compression_level">Compresión máxima (nivel 9)</string>
    <string name="normalize_compression_level_desc">Usa el nivel de compresión Flate más alto de qpdf.</string>
    <string name="normalize_section_images">Imágenes</string>
    <string name="normalize_optimize_images">Optimizar imágenes</string>
    <string name="normalize_optimize_images_desc">Vuelve a codificar las imágenes con la compresión eficiente de qpdf. Puede haber pérdida si la calidad JPEG es inferior a 100.</string>
    <string name="normalize_jpeg_quality">Calidad JPEG</string>
    <string name="normalize_jpeg_quality_desc">De 0 (tamaño mínimo) a 100 (mejor calidad). Solo se usa al optimizar imágenes.</string>
    <string name="normalize_quality_error">Introduce una calidad de 0 a 100.</string>
    <string name="normalize_section_structure">Estructura</string>
    <string name="normalize_newline">Salto de línea antes de endstream</string>
    <string name="normalize_newline_desc">Añade un salto de línea antes de cada endstream. Ayuda a qpdf a conservar PDF/A.</string>
    <string name="normalize_remove_resources">Eliminar recursos no referenciados</string>
    <string name="normalize_remove_resources_desc">Descarta los recursos de página que no usa ningún contenido de la página.</string>
    <string name="normalize_externalize_images">Externalizar imágenes en línea</string>
    <string name="normalize_externalize_images_desc">Convierte las imágenes incrustadas en los flujos de contenido en objetos de imagen normales.</string>
    <string name="normalize_section_output">Salida</string>
    <string name="normalize_linearize">Linealizar</string>
    <string name="normalize_linearize_desc">Escribe un PDF optimizado para la web que puede mostrar la primera página antes de leer el resto.</string>
    <string name="normalize_pdfa">PDF/A-2b (en la medida de lo posible)</string>
    <string name="normalize_pdfa_desc">Añade la identificación PDF/A-2b y una intención de salida sRGB. Las fuentes y el contenido no se convierten; revisa el resultado antes de archivarlo.</string>

