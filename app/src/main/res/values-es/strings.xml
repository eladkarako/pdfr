    <string name="reorder_pages">Reordenar páginas…</string>
    <string name="reorder_title">Reordenar páginas</string>
    <string name="reorder_body">Indica las páginas que quieres conservar, en el orden que prefieras. Las páginas que omitas se eliminarán. Los números de página se refieren al PDF abierto ahora.</string>
    <string name="reorder_hint">1-3,7,9-e</string>
    <string name="reorder_help">Separa las páginas con comas. Usa un guion para un intervalo y e para la última página. Los espacios se ignoran; se mantienen el orden y las repeticiones.</string>
    <string name="reorder_apply">Reordenar</string>
    <string name="rewrite_replace_note">El nuevo PDF sustituye al documento actual. Para volver al original, vuelve a abrirlo.</string>
    <string name="reorder_done">Se ha creado el PDF reordenado.</string>
