    <string name="normalize_section_structure">Estrutura</string>
    <string name="normalize_newline">Nova linha antes de endstream</string>
    <string name="normalize_newline_desc">Adiciona uma nova linha antes de cada endstream. Ajuda o qpdf a preservar PDF/A.</string>
    <string name="normalize_remove_resources">Remover recursos não referenciados</string>
    <string name="normalize_remove_resources_desc">Descarta os recursos de página que nenhum conteúdo da página utiliza.</string>
    <string name="normalize_externalize_images">Externalizar imagens inline</string>
    <string name="normalize_externalize_images_desc">Move as imagens incorporadas nos fluxos de conteúdo para objetos de imagem normais.</string>
    <string name="normalize_section_output">Saída</string>
    <string name="normalize_linearize">Linearizar</string>
    <string name="normalize_linearize_desc">Escreve um PDF otimizado para a web que pode mostrar a primeira página antes de ler o resto.</string>
