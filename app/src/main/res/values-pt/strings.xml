    <string name="normalize_decode_all_desc">Descomprime todos os fluxos suportados, incluindo imagens JPEG. É melhor combinar com a otimização de imagens.</string>
    <string name="normalize_recompress_flate">Recomprimir Flate</string>
    <string name="normalize_recompress_flate_desc">Descomprime e volta a comprimir os fluxos Flate. Necessário antes de alterar o nível de compressão.</string>
    <string name="normalize_compression_level">Compressão máxima (nível 9)</string>
    <string name="normalize_compression_level_desc">Usa o nível de compressão Flate mais alto do qpdf.</string>
