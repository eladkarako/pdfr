<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_background">#FFFBFE</color>
    <color name="ic_launcher_background">#1F4D42</color>
    <color name="ic_launcher_foreground">#FFFFFFFF</color>

    <!-- Reader pages stay white so PDFs and images keep their own colours. -->
    <color name="reader_page_background">#FFFFFFFF</color>
    <!-- Placeholder shown while the first page bitmap is still rendering. -->
    <color name="reader_page_placeholder">#FFF4F4F4</color>
    <!-- Line numbers and other secondary plain-text chrome. -->
    <color name="reader_text_muted">#FF888888</color>

    <!-- PDF text-selection highlight. Fixed blue rather than a theme colour
         because reader pages are always white, so this stays visible even when
         the app's primary colour is very dark. -->
    <color name="selection_fill">#992196F3</color>
    <color name="selection_outline">#E60D47A1</color>
</resources>
