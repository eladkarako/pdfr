    <string name="normalize_remove_resources_desc">Drop page resources that no content on the page uses.</string>
    <string name="normalize_externalize_images">Externalise inline images</string>
    <string name="normalize_externalize_images_desc">Move images embedded in content streams into regular image objects.</string>
